datasource db {
  provider   = "postgresql"
  url        = env("DIRECT_DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  runtime         = "cloudflare"
  previewFeatures = ["postgresqlExtensions", "typedSql"]
}

generator markdown {
  provider = "prisma-markdown"
  output   = "../../../../docs/ERD.md"
  title    = "Database Schema"
}
