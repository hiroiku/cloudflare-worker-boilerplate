/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "",

	"compatibility_date": "2026-02-05",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./server/entry.worker.mjs",
	"name": "cloudflare-worker-boilerplate",

	/**
	 * Observability
	 * https://developers.cloudflare.com/workers/observability/
	 */
	"observability": {
		"enabled": true
	},

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	"placement": { "mode": "smart" },

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/
	 */
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"html_handling": "drop-trailing-slash"
	},

	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {
		"ORIGIN": "http://localhost:5173"
	},

	/**
	 * Environments
	 * https://developers.cloudflare.com/workers/wrangler/environments/
	 * vars is non-inheritable, so each environment must define all vars.
	 */
	"env": {
		"develop": {
			"vars": {
				"ORIGIN": "https://cloudflare-worker-boilerplate-develop.example.workers.dev"
			}
		},
		"staging": {
			"vars": {
				"ORIGIN": "https://cloudflare-worker-boilerplate-staging.example.workers.dev"
			}
		},
		"production": {
			"name": "cloudflare-worker-boilerplate",
			"vars": {
				"ORIGIN": "https://cloudflare-worker-boilerplate.example.workers.dev"
			}
		}
	}
}
